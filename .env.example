# URL ของ backend API (ค่า default คือ http://localhost:8000 ถ้าไม่ตั้งไว้)
VITE_API_BASE_URL=http://localhost:8000

# Google Sign-In — สร้าง OAuth Client ID (Web application) ได้ที่
# https://console.cloud.google.com/apis/credentials
# ต้องใช้ค่าเดียวกันกับ GOOGLE_CLIENT_ID ใน .env ของ backend (root ของโปรเจกต์)
VITE_GOOGLE_CLIENT_ID=
